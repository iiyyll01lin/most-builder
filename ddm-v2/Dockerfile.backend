# ─── DDM-V2 Backend — production-ready image ──────────────────────────────────
# Uses offline wheel cache when available; falls back to network install.
# Health check exposed on GET /api/v1/health.

FROM python:3.11-slim AS base

ARG HTTP_PROXY
ARG HTTPS_PROXY
ARG NO_PROXY
ARG http_proxy
ARG https_proxy
ARG no_proxy

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    DDM_ROOT_DIR=/app \
    DDM_DATA_DIR=/app/data \
    DDM_DB_PATH=/app/data/runtime-db.json \
    HTTP_PROXY=${HTTP_PROXY} \
    HTTPS_PROXY=${HTTPS_PROXY} \
    NO_PROXY=${NO_PROXY} \
    http_proxy=${http_proxy} \
    https_proxy=${https_proxy} \
    no_proxy=${no_proxy}

WORKDIR /app

# Create a non-root user before installing deps
RUN useradd --create-home --uid 1001 --shell /usr/sbin/nologin appuser

# ── Install Python dependencies ────────────────────────────────────────────────
COPY pyproject.toml README.md ./
COPY src ./src

# Prefer offline wheels when present; fall back to PyPI transparently.
# The trailing slash form is safe even if docker-wheels/ contains only a .gitkeep.
COPY docker-wheels/ ./docker-wheels/

RUN pip install --upgrade pip \
    && if ls ./docker-wheels/*.whl > /dev/null 2>&1; then \
         pip install --find-links ./docker-wheels -e . ; \
       else \
         pip install -e . ; \
       fi \
    && mkdir -p /app/data \
    && chown -R appuser:appuser /app

USER appuser

EXPOSE 8000

HEALTHCHECK --interval=10s --timeout=5s --start-period=20s --retries=5 \
    CMD python -c "import urllib.request; urllib.request.urlopen('http://localhost:8000/api/v1/health')"

CMD ["uvicorn", "ddm_v2.main:app", \
     "--host", "0.0.0.0", \
     "--port", "8000", \
     "--app-dir", "src", \
     "--workers", "1"]
