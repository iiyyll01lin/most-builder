# DDM IE/PE Console — frontend environment variables
# Copy this file to .env.local and fill in real values.
# NEVER commit .env.local to version control.

# Override the WebSocket base URL when the backend is on a different host/port.
# Defaults to ws(s)://window.location.host at runtime, so this is optional
# for the standard docker-compose setup where the Vite proxy forwards /api.
VITE_WS_BASE=ws://localhost:8000
